# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Node ----
node_modules/
npm-debug.log*

# ---- .NET launcher build output ----
launcher/bin/
launcher/obj/

# Launcher binaries at repo root (rebuild with build-launcher.ps1)
/MathModelingPaperOS.exe
/MathModelingPaperOS.dll
/MathModelingPaperOS.deps.json
/MathModelingPaperOS.runtimeconfig.json
/PaperOS.exe
/PaperOS.dll
/PaperOS.deps.json
/PaperOS.runtimeconfig.json

# WebView2 assemblies and native loaders restored during the launcher build
/Microsoft.Web.WebView2.*.dll
/runtimes/

# .NET CLI home / telemetry captured during local builds
.dotnet/

# ---- Packaging / distribution output ----
dist/
**/submission-package/

# ---- Local, environment-specific config (may hold private settings) ----
product/runtime/providers.local.json

# ---- Local runtime data (accounts, sessions, community posts) ----
app/data/

# ---- External skill package archives (reference material, not product source) ----
*.zip

# ---- LaTeX build artifacts (keep .tex sources and final .pdf) ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz

# ---- Web / desktop bundles (regenerate with npm run build) ----
app/public/
app/ide/

# ---- Tauri / Rust build and generated output ----
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# ---- Agent / tool session state ----
.omx/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
