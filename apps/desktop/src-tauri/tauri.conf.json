{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper OS",
  "version": "0.6.0",
  "identifier": "dev.paper-os.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3719/ide/",
    "beforeBuildCommand": "node ../build-ide.mjs",
    "frontendDist": "../../../app/ide"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paper OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LaTeX native IDE",
    "longDescription": "Paper OS is a Cursor-class desktop IDE for LaTeX: local compile, AI co-writing, evidence-traced reviews.",
    "publisher": "Paper OS Team"
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["paperos"]
      }
    }
  }
}
